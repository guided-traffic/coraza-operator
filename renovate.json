{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":automergeDigest",
    "helpers:pinGitHubActionDigests"
  ],
  "schedule": [
    "at any time"
  ],
  "timezone": "Europe/Berlin",
  "labels": [
    "dependencies"
  ],
  "platformAutomerge": true,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "ignoreTests": false,
  "prConcurrentLimit": 3,
  "prHourlyLimit": 0,
  "branchConcurrentLimit": 0,
  "rebaseWhen": "conflicted",
  "postUpdateOptions": [
    "gomodTidy",
    "gomodUpdateImportPaths"
  ],
  "packageRules": [
    {
      "description": "Go version: one PR updates every place the Go version is pinned - go.mod, Dockerfile, Dockerfile.engine, .devcontainer/devcontainer.json and the GO_VERSION env in both workflows. Every custom manager below emits datasource=golang-version, so this single group collects all of them.",
      "matchDatasources": [
        "golang-version"
      ],
      "groupName": "Go version",
      "groupSlug": "go-version"
    },
    {
      "description": "The Go builder image is owned by the custom golang-version manager so it lands in the Go version PR. Without this the built-in dockerfile manager would open a second, competing PR on the same FROM line.",
      "matchManagers": [
        "dockerfile"
      ],
      "matchPackageNames": [
        "golang"
      ],
      "enabled": false
    },
    {
      "description": "Same for the devcontainer image: the custom manager owns it, the built-in devcontainer manager must not race it.",
      "matchManagers": [
        "devcontainer"
      ],
      "matchPackageNames": [
        "golang"
      ],
      "enabled": false
    },
    {
      "description": "The go/toolchain directives in go.mod are owned by the custom manager too. Renovate's gomod manager also extracts them (depType golang/toolchain) depending on version; disabling those depTypes keeps exactly one manager per line. No-op if this Renovate build does not extract them.",
      "matchManagers": [
        "gomod"
      ],
      "matchDepTypes": [
        "golang",
        "toolchain"
      ],
      "enabled": false
    },
    {
      "description": "Bundle golang.org/x/* updates with Go version bumps so govulncheck sees a consistent set (e.g. golang.org/x/net fixes shipped alongside Go releases)",
      "matchManagers": [
        "gomod"
      ],
      "matchPackageNames": [
        "/^golang\\.org\\/x\\//"
      ],
      "groupName": "Go version",
      "groupSlug": "go-version"
    },
    {
      "description": "Go version: automerge minor and patch updates after CI passes",
      "matchDatasources": [
        "golang-version"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true
    },
    {
      "description": "Go version: require manual review for major updates",
      "matchDatasources": [
        "golang-version"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "labels": [
        "dependencies",
        "major-update"
      ]
    },
    {
      "description": "Go modules: enable updates for indirect dependencies so transitive security patches (e.g. golang.org/x/net via govulncheck) land without waiting for a direct require to bump",
      "matchManagers": [
        "gomod"
      ],
      "matchDepTypes": [
        "indirect"
      ],
      "enabled": true
    },
    {
      "description": "Go modules: automerge minor and patch updates after CI passes",
      "matchManagers": [
        "gomod"
      ],
      "matchDepTypes": [
        "require",
        "indirect"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "automerge": true
    },
    {
      "description": "Go modules: require manual review for major updates on direct requires",
      "matchManagers": [
        "gomod"
      ],
      "matchDepTypes": [
        "require"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "labels": [
        "dependencies",
        "major-update"
      ]
    },
    {
      "description": "Go modules: never open major PRs for indirect deps. Module-path bumps (/v2 -> /v3) cannot be auto-applied without a direct importer, so go mod tidy resets the indirect line to the MVS minimum and Renovate keeps re-opening the same downgrade PR. Major updates land via the parent direct dependency.",
      "matchManagers": [
        "gomod"
      ],
      "matchDepTypes": [
        "indirect"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "Docker base images (non-Go): automerge minor and patch updates",
      "matchManagers": [
        "dockerfile"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "automerge": true
    },
    {
      "description": "Docker base images: require manual review for major updates",
      "matchManagers": [
        "dockerfile"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "labels": [
        "dependencies",
        "major-update"
      ]
    },
    {
      "description": "GitHub Actions: automerge all updates after CI passes",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch",
        "digest"
      ],
      "automerge": true
    },
    {
      "description": "Helm charts: automerge minor and patch updates",
      "matchManagers": [
        "helm-values",
        "helmv3"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true
    },
    {
      "description": "Helm charts: require manual review for major updates",
      "matchManagers": [
        "helm-values",
        "helmv3"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "labels": [
        "dependencies",
        "major-update"
      ]
    },
    {
      "description": "Makefile-pinned Go tools (custom regex manager): automerge minor and patch updates",
      "matchManagers": [
        "custom.regex"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "automerge": true
    },
    {
      "description": "Makefile-pinned Go tools (custom regex manager): require manual review for major updates",
      "matchManagers": [
        "custom.regex"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "labels": [
        "dependencies",
        "major-update"
      ]
    },
    {
      "description": "Group Kubernetes-related Go dependencies",
      "matchManagers": [
        "gomod"
      ],
      "groupName": "Kubernetes Go modules",
      "groupSlug": "k8s-go-modules",
      "matchPackageNames": [
        "/^k8s.io//",
        "/^sigs.k8s.io//"
      ]
    },
    {
      "description": "Use 'fix' instead of 'chore' for dependency updates",
      "semanticCommitType": "fix",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin"
      ]
    },
    {
      "description": "GitHub Actions: use 'chore' instead of 'fix' for updates",
      "matchManagers": [
        "github-actions"
      ],
      "semanticCommitType": "chore"
    }
  ],
  "customManagers": [
    {
      "description": "Update Go tool versions pinned in Makefile via renovate comments",
      "customType": "regex",
      "managerFilePatterns": [
        "/^Makefile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)\\n.+\\?=\\s*(?<currentValue>v[\\d.]+)"
      ],
      "versioningTemplate": "semver"
    },
    {
      "description": "Go version in the container images and the devcontainer. Uses the golang-version datasource (not docker) so these land in the same PR as go.mod and the workflow pins; the built-in dockerfile and devcontainer managers are disabled for golang in packageRules.",
      "customType": "regex",
      "managerFilePatterns": [
        "/^Dockerfile$/",
        "/^Dockerfile\\.engine$/",
        "/^\\.devcontainer/devcontainer\\.json$/"
      ],
      "matchStrings": [
        "FROM\\s+(?:--platform=\\S+\\s+)?golang:(?<currentValue>[\\d.]+)",
        "\"image\":\\s*\"golang:(?<currentValue>[\\d.]+)\""
      ],
      "depNameTemplate": "golang",
      "datasourceTemplate": "golang-version",
      "versioningTemplate": "semver"
    },
    {
      "description": "Go version in go.mod. The second pattern covers a toolchain directive; there is none today, but `go mod tidy` can re-add one and it must not drift from the go directive.",
      "customType": "regex",
      "managerFilePatterns": [
        "/^go\\.mod$/"
      ],
      "matchStrings": [
        "\\ngo\\s+(?<currentValue>[\\d.]+)\\n",
        "\\ntoolchain go(?<currentValue>[\\d.]+)\\n"
      ],
      "depNameTemplate": "golang",
      "datasourceTemplate": "golang-version",
      "versioningTemplate": "semver"
    },
    {
      "description": "Go toolchain pinned as GO_VERSION in the GitHub workflows.",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "GO_VERSION:\\s+['\"]?(?<currentValue>[\\d.]+)['\"]?"
      ],
      "depNameTemplate": "golang",
      "datasourceTemplate": "golang-version",
      "versioningTemplate": "semver"
    },
    {
      "description": "Update the Kind version and node image pinned in GitHub workflows",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "KIND_VERSION:\\s+['\"]?(?<currentValue>v[\\d.]+)['\"]?"
      ],
      "depNameTemplate": "kubernetes-sigs/kind",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    }
  ],
  "gomod": {
    "enabled": true,
    "postUpdateOptions": [
      "gomodTidy",
      "gomodUpdateImportPaths"
    ]
  }
}
