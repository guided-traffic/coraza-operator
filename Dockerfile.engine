# Build stage
ARG GOOS=linux
ARG GOARCH=amd64

FROM --platform=${BUILDPLATFORM:-linux/amd64} golang:1.27.0 AS builder

ARG GOOS
ARG GOARCH

WORKDIR /workspace

# Cache dependencies first.
COPY go.mod go.sum ./
RUN go mod download

# Copy source.
COPY . .

# Build the engine binary with reproducible flags.
RUN GOOS=${GOOS} GOARCH=${GOARCH} go build \
    -trimpath \
    -ldflags="-s -w" \
    -o /engine \
    ./cmd/engine

# Final stage: distroless static for a minimal attack surface.
FROM gcr.io/distroless/static-debian12:nonroot

USER nonroot:nonroot

COPY --from=builder /engine /engine

ENTRYPOINT ["/engine"]
